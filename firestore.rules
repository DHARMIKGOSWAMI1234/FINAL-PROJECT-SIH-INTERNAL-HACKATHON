rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User profile documents and subcollections (users/{userId})
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level recommendations collection
    match /recommendations/{recommendationId} {
      // Authenticated user can read, update, or delete only their own recommendation records
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;

      // Authenticated user can create a recommendation only when userId matches their authenticated UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
