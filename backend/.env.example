# AGRISENSE Backend Environment Configuration

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGIN=http://localhost:5173

# OpenWeather API Configuration (Server-side only)
WEATHER_API_KEY=your_openweather_api_key

# Google Gemini API Configuration (Server-side only)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-flash-latest

# ML Model Paths (Optional overrides, defaults to backend/models/)
# CROP_MODEL_PATH=models/crop_recommendation_model.joblib
# FERTILIZER_MODEL_PATH=models/fertilizer_model.joblib
